      <ui:InvokeCode ContinueOnError="{x:Null}" Code="' Parse the query JSON object into parallel key/value lists.&#xA;' Throws on malformed JSON or an empty object (propagates to caller).&#xA;out_Keys = New System.Collections.Generic.List(Of String)()&#xA;out_Values = New System.Collections.Generic.List(Of String)()&#xA;Dim jo As Newtonsoft.Json.Linq.JObject = Newtonsoft.Json.Linq.JObject.Parse(in_QueryJson)&#xA;For Each prop As Newtonsoft.Json.Linq.JProperty In jo.Properties()&#xA;    out_Keys.Add(prop.Name)&#xA;    out_Values.Add(prop.Value.ToString())&#xA;Next&#xA;If out_Keys.Count = 0 Then&#xA;    Throw New System.Exception(&quot;Query JSON contained no keys: &quot; &amp; in_QueryJson)&#xA;End If" DisplayName="Invoke Code - ParseQuery" sap:VirtualizedContainerService.HintSize="452,197" sap2010:WorkflowViewState.IdRef="InvokeCode_2">
        <ui:InvokeCode.Arguments>
          <InArgument x:TypeArguments="x:String" x:Key="in_QueryJson">[in_QueryJson]</InArgument>
          <OutArgument x:TypeArguments="scg:List(x:String)" x:Key="out_Keys">[qKeys]</OutArgument>
          <OutArgument x:TypeArguments="scg:List(x:String)" x:Key="out_Values">[qValues]</OutArgument>
        </ui:InvokeCode.Arguments>
      </ui:InvokeCode>
      <ui:InvokeCode ContinueOnError="{x:Null}" Code="' Decide which queried values actually need a vector, BEFORE any HTTP call.&#xA;' A key needs one only when it is stored 'semantic' AND is not a filter key -&#xA;' filters match by exact string equality whatever their stored mode. A query&#xA;' that is all-exact or all-filter therefore makes no embedding call at all.&#xA;' The store's model identity is checked here too, so a mismatch fails before a&#xA;' pointless embedding request instead of after it.&#xA;' If the store cannot be read (not initialised yet), fall back to embedding&#xA;' every non-filter key and let ScoreFieldsSemantic report the real problem.&#xA;out_Success = False&#xA;out_ErrorMessage = &quot;&quot;&#xA;out_EmbedTexts = New System.Collections.Generic.List(Of String)()&#xA;out_EmbedIndex = New System.Collections.Generic.List(Of Integer)()&#xA;Try&#xA;    Dim filterSet As New System.Collections.Generic.HashSet(Of String)(System.StringComparer.OrdinalIgnoreCase)&#xA;    If in_FilterKeys IsNot Nothing Then&#xA;        For Each fk As String In in_FilterKeys&#xA;            If Not String.IsNullOrWhiteSpace(fk) Then filterSet.Add(fk.Trim())&#xA;        Next&#xA;    End If&#xA;&#xA;    Dim storedModel As String = Nothing&#xA;    Dim modes As New System.Collections.Generic.Dictionary(Of String, String)(System.StringComparer.OrdinalIgnoreCase)&#xA;    Dim modesKnown As Boolean = False&#xA;&#xA;    Try&#xA;        Using conn As New Microsoft.Data.Sqlite.SqliteConnection(&quot;Data Source=&quot; &amp; in_DbPath &amp; &quot;;Pooling=False&quot;)&#xA;            conn.Open()&#xA;&#xA;            Using cmd As Microsoft.Data.Sqlite.SqliteCommand = conn.CreateCommand()&#xA;                cmd.CommandText = &quot;SELECT value FROM meta WHERE key = 'embedding_model';&quot;&#xA;                Dim o As Object = cmd.ExecuteScalar()&#xA;                If o IsNot Nothing AndAlso Not Convert.IsDBNull(o) Then storedModel = o.ToString()&#xA;            End Using&#xA;&#xA;            ' one row per (key, mode) actually stored; keys are user input, so&#xA;            ' the IN-list is parameterized rather than concatenated&#xA;            Using cmd As Microsoft.Data.Sqlite.SqliteCommand = conn.CreateCommand()&#xA;                Dim names As New System.Collections.Generic.List(Of String)()&#xA;                For i As Integer = 0 To in_QueryKeys.Count - 1&#xA;                    Dim pn As String = &quot;$k&quot; &amp; i.ToString()&#xA;                    names.Add(pn)&#xA;                    cmd.Parameters.AddWithValue(pn, in_QueryKeys(i))&#xA;                Next&#xA;                cmd.CommandText = &quot;SELECT DISTINCT field_key, field_mode FROM chunk_fields WHERE field_key IN (&quot; &amp; String.Join(&quot;,&quot;, names) &amp; &quot;);&quot;&#xA;                Using rd As Microsoft.Data.Sqlite.SqliteDataReader = cmd.ExecuteReader()&#xA;                    Do While rd.Read()&#xA;                        Dim k As String = rd.GetString(0)&#xA;                        Dim m As String = rd.GetString(1)&#xA;                        ' if a key is stored in both modes, semantic wins: the&#xA;                        ' vector is then available and exact rows ignore it&#xA;                        If (Not modes.ContainsKey(k)) OrElse String.Equals(m, &quot;semantic&quot;, StringComparison.OrdinalIgnoreCase) Then&#xA;                            modes(k) = m&#xA;                        End If&#xA;                    Loop&#xA;                End Using&#xA;            End Using&#xA;        End Using&#xA;        modesKnown = True&#xA;    Catch dbEx As System.Exception&#xA;        modesKnown = False&#xA;    End Try&#xA;&#xA;    ' Outside the Catch above, so a real mismatch is never swallowed.&#xA;    If modesKnown AndAlso Not String.IsNullOrWhiteSpace(storedModel) Then&#xA;        Dim have As String = storedModel.Trim().ToLowerInvariant()&#xA;        If have.LastIndexOf(&quot;/&quot;c) &gt;= 0 Then have = have.Substring(have.LastIndexOf(&quot;/&quot;c) + 1)&#xA;        Dim want As String = If(in_Model, &quot;&quot;).Trim().ToLowerInvariant()&#xA;        If want.LastIndexOf(&quot;/&quot;c) &gt;= 0 Then want = want.Substring(want.LastIndexOf(&quot;/&quot;c) + 1)&#xA;        If have &lt;&gt; want Then&#xA;            Throw New System.Exception(&#xA;                &quot;Embedding model mismatch. This store was built with '&quot; &amp; storedModel &amp;&#xA;                &quot;' but this query was embedded with '&quot; &amp; If(in_Model, &quot;&quot;) &amp;&#xA;                &quot;'. Scores across two different models are meaningless - &quot; &amp;&#xA;                &quot;retrieve with the model the store was ingested with.&quot;)&#xA;        End If&#xA;    End If&#xA;&#xA;    For i As Integer = 0 To in_QueryKeys.Count - 1&#xA;        Dim k As String = in_QueryKeys(i)&#xA;        If filterSet.Contains(k) Then Continue For&#xA;        If modesKnown Then&#xA;            Dim m As String = Nothing&#xA;            If modes.TryGetValue(k, m) Then&#xA;                If String.Equals(m, &quot;semantic&quot;, StringComparison.OrdinalIgnoreCase) Then&#xA;                    out_EmbedTexts.Add(in_QueryValues(i))&#xA;                    out_EmbedIndex.Add(i)&#xA;                End If&#xA;            End If&#xA;            ' a key absent from the store cannot match anything, so it needs no vector&#xA;        Else&#xA;            out_EmbedTexts.Add(in_QueryValues(i))&#xA;            out_EmbedIndex.Add(i)&#xA;        End If&#xA;    Next&#xA;&#xA;    out_Success = True&#xA;Catch ex As System.Exception&#xA;    out_ErrorMessage = &quot;PlanQueryEmbedding failed: &quot; &amp; ex.Message&#xA;    If ex.InnerException IsNot Nothing Then out_ErrorMessage &amp;= &quot; | Inner: &quot; &amp; ex.InnerException.Message&#xA;End Try&#xA;" DisplayName="Invoke Code - PlanQueryEmbedding" sap2010:WorkflowViewState.IdRef="InvokeCode_Plan_1">
