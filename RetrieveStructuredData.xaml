      <ui:InvokeCode ContinueOnError="{x:Null}" Code="' Scatter the vectors that were actually requested back into a list aligned to&#xA;' the query keys. Keys that needed none stay Nothing, which ScoreFieldsSemantic&#xA;' already tolerates (exact and filter keys ignore their vector slot).&#xA;out_Success = False&#xA;out_ErrorMessage = &quot;&quot;&#xA;out_QueryVectors = New System.Collections.Generic.List(Of Double())()&#xA;Try&#xA;    For i As Integer = 0 To in_KeyCount - 1&#xA;        out_QueryVectors.Add(Nothing)&#xA;    Next&#xA;&#xA;    Dim want As Integer = 0&#xA;    If in_EmbedIndex IsNot Nothing Then want = in_EmbedIndex.Count&#xA;    Dim got As Integer = 0&#xA;    If in_Embeddings IsNot Nothing Then got = in_Embeddings.Count&#xA;    If got &lt;&gt; want Then&#xA;        Throw New System.Exception(&#xA;            &quot;expected &quot; &amp; want.ToString() &amp; &quot; vector(s) for the semantic query keys but got &quot; &amp;&#xA;            got.ToString() &amp; &quot;.&quot;)&#xA;    End If&#xA;&#xA;    For j As Integer = 0 To want - 1&#xA;        out_QueryVectors(in_EmbedIndex(j)) = in_Embeddings(j)&#xA;    Next&#xA;&#xA;    out_Success = True&#xA;Catch ex As System.Exception&#xA;    out_ErrorMessage = &quot;ScatterVectors failed: &quot; &amp; ex.Message&#xA;End Try&#xA;" DisplayName="Invoke Code - ScatterVectors" sap2010:WorkflowViewState.IdRef="InvokeCode_Scatter_1">
