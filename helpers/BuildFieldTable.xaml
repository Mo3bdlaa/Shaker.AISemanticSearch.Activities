    <ui:InvokeCode ContinueOnError="{x:Null}" Code="' ================================================================&#xA;' BuildFieldTable  (PRIVATE - used by IngestStructured)&#xA;' Explodes a sheet (one record per row) into two flat tables:&#xA;'   out_Rows   : RowKey, DocId, Source, ContentJson  (one per record)&#xA;'   out_Fields : RowKey, FieldKey, FieldValue, Mode   (one per non-empty cell)&#xA;' Mode is &quot;exact&quot; for columns named in in_ExactColumns (case-insensitive),&#xA;' otherwise &quot;semantic&quot;. ContentJson preserves column order. Empty cells stay&#xA;' in ContentJson but are NOT emitted as fields (nothing to embed/match).&#xA;' DocId = in_DocIdColumn value if given/non-empty, else &quot;&lt;source&gt;#row&lt;N&gt;&quot;.&#xA;' Requires Newtonsoft.Json (bundled with UiPath).&#xA;' ================================================================&#xA;out_Success = False&#xA;out_ErrorMessage = &quot;&quot;&#xA;out_Rows = New System.Data.DataTable()&#xA;out_Rows.Columns.Add(&quot;RowKey&quot;, GetType(Integer))&#xA;out_Rows.Columns.Add(&quot;DocId&quot;, GetType(String))&#xA;out_Rows.Columns.Add(&quot;Source&quot;, GetType(String))&#xA;out_Rows.Columns.Add(&quot;ContentJson&quot;, GetType(String))&#xA;out_Fields = New System.Data.DataTable()&#xA;out_Fields.Columns.Add(&quot;RowKey&quot;, GetType(Integer))&#xA;out_Fields.Columns.Add(&quot;FieldKey&quot;, GetType(String))&#xA;out_Fields.Columns.Add(&quot;FieldValue&quot;, GetType(String))&#xA;out_Fields.Columns.Add(&quot;Mode&quot;, GetType(String))&#xA;&#xA;Try&#xA;    Dim exact As New System.Collections.Generic.HashSet(Of String)(System.StringComparer.OrdinalIgnoreCase)&#xA;    If in_ExactColumns IsNot Nothing Then&#xA;        For Each c As String In in_ExactColumns&#xA;            If Not String.IsNullOrEmpty(c) Then exact.Add(c)&#xA;        Next&#xA;    End If&#xA;    Dim src As String = If(in_Source, &quot;&quot;)&#xA;    Dim hasDocCol As Boolean = (Not String.IsNullOrEmpty(in_DocIdColumn)) AndAlso in_Sheet.Columns.Contains(in_DocIdColumn)&#xA;&#xA;    For r As Integer = 0 To in_Sheet.Rows.Count - 1&#xA;        Dim row As System.Data.DataRow = in_Sheet.Rows(r)&#xA;&#xA;        Dim docId As String = &quot;&quot;&#xA;        If hasDocCol Then docId = row(in_DocIdColumn).ToString()&#xA;        If String.IsNullOrEmpty(docId) Then docId = src &amp; &quot;#row&quot; &amp; (r + 1).ToString()&#xA;&#xA;        Dim jo As New Newtonsoft.Json.Linq.JObject()&#xA;        For Each col As System.Data.DataColumn In in_Sheet.Columns&#xA;            Dim key As String = col.ColumnName&#xA;            Dim val As String = row(col).ToString()&#xA;            jo.Add(key, val)&#xA;            If Not String.IsNullOrWhiteSpace(val) Then&#xA;                Dim fr As System.Data.DataRow = out_Fields.NewRow()&#xA;                fr(&quot;RowKey&quot;) = r&#xA;                fr(&quot;FieldKey&quot;) = key&#xA;                fr(&quot;FieldValue&quot;) = val.Trim()   ' trimmed so exact matching isn't broken by stray spaces&#xA;                fr(&quot;Mode&quot;) = If(exact.Contains(key), &quot;exact&quot;, &quot;semantic&quot;)&#xA;                out_Fields.Rows.Add(fr)&#xA;            End If&#xA;        Next&#xA;&#xA;        Dim rr As System.Data.DataRow = out_Rows.NewRow()&#xA;        rr(&quot;RowKey&quot;) = r&#xA;        rr(&quot;DocId&quot;) = docId&#xA;        rr(&quot;Source&quot;) = src&#xA;        rr(&quot;ContentJson&quot;) = jo.ToString(Newtonsoft.Json.Formatting.None)&#xA;        out_Rows.Rows.Add(rr)&#xA;    Next&#xA;&#xA;    out_Success = True&#xA;Catch ex As System.Exception&#xA;    out_Success = False&#xA;    out_ErrorMessage = &quot;BuildFieldTable failed: &quot; &amp; ex.Message&#xA;    If ex.InnerException IsNot Nothing Then out_ErrorMessage &amp;= &quot; | Inner: &quot; &amp; ex.InnerException.Message&#xA;End Try&#xA;" DisplayName="Invoke Code - BuildFieldTable" sap:VirtualizedContainerService.HintSize="450,197" sap2010:WorkflowViewState.IdRef="InvokeCode_1">
