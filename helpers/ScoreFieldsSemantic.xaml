    <ui:InvokeCode ContinueOnError="{x:Null}" Code="' ================================================================&#xA;' ScoreFieldsSemantic  (PRIVATE - used by RetrieveStructured)&#xA;' Per-key match over chunk_fields. The STORED field_mode decides scoring:&#xA;'   semantic -&gt; cosine(queryVec(key), storedVec)   (both unit-normalized)&#xA;'   exact    -&gt; 1.0 if storedValue equals queryValue (case-insensitive) else 0&#xA;' Keys listed in in_FilterKeys are HARD PREDICATES: a chunk is returned only&#xA;' if every filter key is present and matches exactly (trimmed, case-insensitive)&#xA;' whatever mode it was ingested in. Filter keys never contribute to the score.&#xA;' A chunk's score = sum of contributions / number of NON-filter queried keys,&#xA;' so chunks matching more keys rank higher. Returns top-N shaped like&#xA;' ScoreChunks (Rank,DocId,ChunkIndex,Content,Score).&#xA;' Vector alignment: in_QueryVectors aligned to in_QueryKeys (one per key;&#xA;' exact keys' vectors go unused). Key match is ordinal, case-insensitive.&#xA;' On failure: out_Success=False + out_ErrorMessage, empty table back.&#xA;' ================================================================&#xA;out_Success = False&#xA;out_ErrorMessage = &quot;&quot;&#xA;out_Results = New System.Data.DataTable()&#xA;out_Results.Columns.Add(&quot;Rank&quot;, GetType(Integer))&#xA;out_Results.Columns.Add(&quot;DocId&quot;, GetType(String))&#xA;out_Results.Columns.Add(&quot;ChunkIndex&quot;, GetType(Integer))&#xA;out_Results.Columns.Add(&quot;Content&quot;, GetType(String))&#xA;out_Results.Columns.Add(&quot;Score&quot;, GetType(Double))&#xA;&#xA;Try&#xA;    Dim nKeys As Integer = in_QueryKeys.Count&#xA;    If nKeys = 0 Then&#xA;        Throw New System.Exception(&quot;No query keys supplied.&quot;)&#xA;    End If&#xA;    If in_QueryValues.Count &lt;&gt; nKeys OrElse in_QueryVectors.Count &lt;&gt; nKeys Then&#xA;        Throw New System.Exception(&quot;Query keys/values/vectors length mismatch.&quot;)&#xA;    End If&#xA;&#xA;    Dim keyIndex As New System.Collections.Generic.Dictionary(Of String, Integer)(System.StringComparer.OrdinalIgnoreCase)&#xA;    For i As Integer = 0 To nKeys - 1&#xA;        If Not keyIndex.ContainsKey(in_QueryKeys(i)) Then keyIndex(in_QueryKeys(i)) = i&#xA;    Next&#xA;&#xA;    ' ---- filter keys: a queried key listed in in_FilterKeys is a hard&#xA;    '      predicate rather than a score contributor. Unset/Nothing keeps the&#xA;    '      original all-keys-score behaviour, so existing callers are unaffected.&#xA;    Dim filterSet As New System.Collections.Generic.HashSet(Of String)(System.StringComparer.OrdinalIgnoreCase)&#xA;    If in_FilterKeys IsNot Nothing Then&#xA;        For Each fk As String In in_FilterKeys&#xA;            If Not String.IsNullOrWhiteSpace(fk) AndAlso keyIndex.ContainsKey(fk.Trim()) Then filterSet.Add(fk.Trim())&#xA;        Next&#xA;    End If&#xA;    Dim nScoring As Integer = nKeys - filterSet.Count&#xA;&#xA;    Dim sumByChunk As New System.Collections.Generic.Dictionary(Of Long, Double)()&#xA;    Dim hitFilters As New System.Collections.Generic.Dictionary(Of Long, System.Collections.Generic.HashSet(Of String))()&#xA;&#xA;    Using conn As New Microsoft.Data.Sqlite.SqliteConnection(&quot;Data Source=&quot; &amp; in_DbPath &amp; &quot;;Pooling=False&quot;)&#xA;        conn.Open()&#xA;        ' ---- Guard: the store belongs to exactly ONE embedding model ----&#xA;        ' Vectors from two different models are not comparable: cosine over&#xA;        ' them yields plausible-looking numbers that mean nothing. The dim&#xA;        ' check below only catches models of DIFFERENT size, and 1024 is a&#xA;        ' very common size - so compare the recorded model name too.&#xA;        ' Names compare with the provider/org prefix stripped, so&#xA;        ' &quot;BAAI/bge-m3&quot; and &quot;bge-m3&quot; are the same model. A version or tag&#xA;        ' suffix is NOT stripped - &quot;bge-large-en&quot; and &quot;bge-large-en-v1.5&quot;&#xA;        ' are different models that happen to share a dimension.&#xA;        ' No recorded model (brand-new or empty store) = nothing to compare.&#xA;        Dim storedModel As String = Nothing&#xA;        Using cmd As Microsoft.Data.Sqlite.SqliteCommand = conn.CreateCommand()&#xA;            cmd.CommandText = &quot;SELECT value FROM meta WHERE key = 'embedding_model';&quot;&#xA;            Dim o As Object = cmd.ExecuteScalar()&#xA;            If o IsNot Nothing AndAlso Not Convert.IsDBNull(o) Then storedModel = o.ToString()&#xA;        End Using&#xA;&#xA;        If Not String.IsNullOrWhiteSpace(storedModel) Then&#xA;            Dim have As String = storedModel.Trim().ToLowerInvariant()&#xA;            If have.LastIndexOf(&quot;/&quot;c) &gt;= 0 Then have = have.Substring(have.LastIndexOf(&quot;/&quot;c) + 1)&#xA;            Dim want As String = If(in_Model, &quot;&quot;).Trim().ToLowerInvariant()&#xA;            If want.LastIndexOf(&quot;/&quot;c) &gt;= 0 Then want = want.Substring(want.LastIndexOf(&quot;/&quot;c) + 1)&#xA;            If have &lt;&gt; want Then&#xA;                Throw New System.Exception(&#xA;                    &quot;Embedding model mismatch. This store was built with '&quot; &amp; storedModel &amp;&#xA;                    &quot;' but this query was embedded with '&quot; &amp; If(in_Model, &quot;&quot;) &amp;&#xA;                    &quot;'. Scores across two different models are meaningless - &quot; &amp;&#xA;                    &quot;retrieve with the model the store was ingested with.&quot;)&#xA;            End If&#xA;        End If&#xA;&#xA;&#xA;        ' ---- scan only the queried keys; parameterized IN-list (keys are&#xA;        '      user input -&gt; never concatenate) ----&#xA;        Using cmd As Microsoft.Data.Sqlite.SqliteCommand = conn.CreateCommand()&#xA;            Dim names As New System.Collections.Generic.List(Of String)()&#xA;            For i As Integer = 0 To nKeys - 1&#xA;                Dim pn As String = &quot;$k&quot; &amp; i.ToString()&#xA;                names.Add(pn)&#xA;                cmd.Parameters.AddWithValue(pn, in_QueryKeys(i))&#xA;            Next&#xA;            cmd.CommandText = &quot;SELECT chunk_id, field_key, field_value, field_mode, embedding FROM chunk_fields WHERE field_key IN (&quot; &amp; String.Join(&quot;,&quot;, names) &amp; &quot;);&quot;&#xA;&#xA;            Using rd As Microsoft.Data.Sqlite.SqliteDataReader = cmd.ExecuteReader()&#xA;                Do While rd.Read()&#xA;                    Dim cid As Long = rd.GetInt64(0)&#xA;                    Dim fkey As String = rd.GetString(1)&#xA;                    Dim fval As String = rd.GetString(2)&#xA;                    Dim fmode As String = rd.GetString(3)&#xA;                    Dim kidx As Integer = -1&#xA;                    If keyIndex.TryGetValue(fkey, kidx) Then&#xA;                        If filterSet.Contains(fkey) Then&#xA;                            ' hard predicate: exact string equality regardless of stored mode&#xA;                            If String.Equals(If(fval, &quot;&quot;).Trim(), If(in_QueryValues(kidx), &quot;&quot;).Trim(), StringComparison.OrdinalIgnoreCase) Then&#xA;                                Dim hs As System.Collections.Generic.HashSet(Of String) = Nothing&#xA;                                If Not hitFilters.TryGetValue(cid, hs) Then&#xA;                                    hs = New System.Collections.Generic.HashSet(Of String)(System.StringComparer.OrdinalIgnoreCase)&#xA;                                    hitFilters(cid) = hs&#xA;                                End If&#xA;                                hs.Add(fkey)&#xA;                            End If&#xA;                            Continue Do&#xA;                        End If&#xA;                        Dim contrib As Double = 0&#xA;                        If String.Equals(fmode, &quot;exact&quot;, StringComparison.OrdinalIgnoreCase) Then&#xA;                            If String.Equals(fval, in_QueryValues(kidx), StringComparison.OrdinalIgnoreCase) Then contrib = 1.0&#xA;                        ElseIf Not rd.IsDBNull(4) Then&#xA;                            Dim qv As Double() = in_QueryVectors(kidx)&#xA;                            If qv IsNot Nothing AndAlso qv.Length &gt; 0 Then&#xA;                                Dim blob As Byte() = CType(rd(4), Byte())&#xA;                                Dim flen As Integer = blob.Length \ 4&#xA;                                If flen &lt;&gt; qv.Length Then&#xA;                                    Throw New System.Exception(&quot;Embedding dim mismatch: stored=&quot; &amp; flen.ToString() &amp; &quot;, query=&quot; &amp; qv.Length.ToString() &amp; &quot; (key '&quot; &amp; fkey &amp; &quot;').&quot;)&#xA;                                End If&#xA;                                Dim fvec(flen - 1) As Single&#xA;                                System.Buffer.BlockCopy(blob, 0, fvec, 0, blob.Length)&#xA;                                Dim dot As Double = 0&#xA;                                For d As Integer = 0 To flen - 1&#xA;                                    dot += qv(d) * CDbl(fvec(d))&#xA;                                Next&#xA;                                contrib = dot&#xA;                            End If&#xA;                        End If&#xA;                        Dim cur As Double = 0&#xA;                        If sumByChunk.TryGetValue(cid, cur) Then&#xA;                            sumByChunk(cid) = cur + contrib&#xA;                        Else&#xA;                            sumByChunk(cid) = contrib&#xA;                        End If&#xA;                    End If&#xA;                Loop&#xA;            End Using&#xA;        End Using&#xA;&#xA;        ' ---- candidates: with filters in play only chunks matching EVERY&#xA;        '      filter key survive. Such a chunk qualifies even if it matched no&#xA;        '      scoring key (score 0), and scores 1.0 when the query was all&#xA;        '      filters. With no filters this is the original candidate set.&#xA;        Dim candidates As New System.Collections.Generic.List(Of Long)()&#xA;        If filterSet.Count &gt; 0 Then&#xA;            For Each fkv As System.Collections.Generic.KeyValuePair(Of Long, System.Collections.Generic.HashSet(Of String)) In hitFilters&#xA;                If fkv.Value.Count = filterSet.Count Then candidates.Add(fkv.Key)&#xA;            Next&#xA;        Else&#xA;            For Each kv As System.Collections.Generic.KeyValuePair(Of Long, Double) In sumByChunk&#xA;                candidates.Add(kv.Key)&#xA;            Next&#xA;        End If&#xA;&#xA;        If candidates.Count &gt; 0 Then&#xA;            ' ---- rank: copy to arrays, Array.Sort ascending, walk from top ----&#xA;            Dim ids As Long() = New Long(candidates.Count - 1) {}&#xA;            Dim scoreArr As Double() = New Double(candidates.Count - 1) {}&#xA;            Dim n As Integer = 0&#xA;            For Each candId As Long In candidates&#xA;                Dim rawScore As Double = 0&#xA;                sumByChunk.TryGetValue(candId, rawScore)&#xA;                ids(n) = candId&#xA;                If nScoring &gt; 0 Then&#xA;                    scoreArr(n) = rawScore / CDbl(nScoring)&#xA;                Else&#xA;                    scoreArr(n) = 1.0&#xA;                End If&#xA;                n += 1&#xA;            Next&#xA;            Array.Sort(scoreArr, ids)&#xA;&#xA;            Dim take As Integer = Math.Min(in_TopN, ids.Length)&#xA;            Dim winnerIds As New System.Collections.Generic.List(Of Long)()&#xA;            Dim winnerScore As New System.Collections.Generic.Dictionary(Of Long, Double)()&#xA;            Dim idx As Integer = ids.Length - 1&#xA;            Do While winnerIds.Count &lt; take AndAlso idx &gt;= 0&#xA;                winnerIds.Add(ids(idx))&#xA;                winnerScore(ids(idx)) = scoreArr(idx)&#xA;                idx -= 1&#xA;            Loop&#xA;&#xA;            If winnerIds.Count &gt; 0 Then&#xA;                ' winnerIds are DB ids -&gt; IN-list concatenation is injection-safe&#xA;                Dim inList As String = String.Join(&quot;,&quot;, winnerIds)&#xA;                Dim details As New System.Collections.Generic.Dictionary(Of Long, String())()&#xA;                Using cmd As Microsoft.Data.Sqlite.SqliteCommand = conn.CreateCommand()&#xA;                    cmd.CommandText = &quot;SELECT id, doc_id, chunk_index, content FROM chunks WHERE id IN (&quot; &amp; inList &amp; &quot;);&quot;&#xA;                    Using rd As Microsoft.Data.Sqlite.SqliteDataReader = cmd.ExecuteReader()&#xA;                        Do While rd.Read()&#xA;                            Dim rid As Long = rd.GetInt64(0)&#xA;                            Dim arr(2) As String&#xA;                            arr(0) = rd(&quot;doc_id&quot;).ToString()&#xA;                            arr(1) = rd(&quot;chunk_index&quot;).ToString()&#xA;                            arr(2) = rd(&quot;content&quot;).ToString()&#xA;                            details(rid) = arr&#xA;                        Loop&#xA;                    End Using&#xA;                End Using&#xA;&#xA;                Dim rank As Integer = 1&#xA;                For Each wid As Long In winnerIds&#xA;                    If details.ContainsKey(wid) Then&#xA;                        Dim drow As System.Data.DataRow = out_Results.NewRow()&#xA;                        drow(&quot;Rank&quot;) = rank&#xA;                        drow(&quot;DocId&quot;) = details(wid)(0)&#xA;                        drow(&quot;ChunkIndex&quot;) = Integer.Parse(details(wid)(1))&#xA;                        drow(&quot;Content&quot;) = details(wid)(2)&#xA;                        drow(&quot;Score&quot;) = winnerScore(wid)&#xA;                        out_Results.Rows.Add(drow)&#xA;                        rank += 1&#xA;                    End If&#xA;                Next&#xA;            End If&#xA;        End If&#xA;    End Using&#xA;&#xA;    out_Success = True&#xA;&#xA;Catch ex As System.Exception&#xA;    out_Success = False&#xA;    If out_Results IsNot Nothing Then out_Results.Rows.Clear()&#xA;    out_ErrorMessage = &quot;ScoreFieldsSemantic failed: &quot; &amp; ex.Message&#xA;    If ex.InnerException IsNot Nothing Then out_ErrorMessage &amp;= &quot; | Inner: &quot; &amp; ex.InnerException.Message&#xA;End Try&#xA;" DisplayName="Invoke Code - ScoreFieldsSemantic" sap:VirtualizedContainerService.HintSize="450,197" sap2010:WorkflowViewState.IdRef="InvokeCode_1">
