    <ui:InvokeCode ContinueOnError="{x:Null}" Code="' ================================================================&#xA;' ReleaseWriteLock&#xA;' Disposing the handle releases the lock instantly. We deliberately&#xA;' do NOT delete store.lock - its existence means nothing; only a held&#xA;' handle blocks anyone.&#xA;'&#xA;' BEST-EFFORT BY CONTRACT: this runs from a Finally block, so it must&#xA;' NEVER throw - a throw here would mask the real error that triggered&#xA;' the Finally. out_Success is therefore ALWAYS True; any disposal hiccup&#xA;' is swallowed and only recorded in out_ErrorMessage for logging.&#xA;' &gt;&gt;&gt; DO NOT put a Check-True-throw after this activity. &lt;&lt;&lt;&#xA;' io_LockStream is set to Nothing (In/Out) so a disposed handle can't be reused.&#xA;' ================================================================&#xA;&#xA;out_Success = True          ' best-effort: a release never reports failure&#xA;out_ErrorMessage = &quot;&quot;&#xA;&#xA;If io_LockStream IsNot Nothing Then&#xA;    Try&#xA;        io_LockStream.Dispose()&#xA;    Catch ex As System.Exception&#xA;        ' Swallow - releasing must never fail the workflow. Record for logs only.&#xA;        out_ErrorMessage = &quot;ReleaseWriteLock: dispose raised (lock released regardless): &quot; &amp; ex.Message&#xA;    End Try&#xA;    io_LockStream = Nothing                   ' prevent accidental reuse&#xA;End If&#xA;" DisplayName="Invoke Code - ReleaseWriteLock" sap:VirtualizedContainerService.HintSize="450,197" sap2010:WorkflowViewState.IdRef="InvokeCode_2">
