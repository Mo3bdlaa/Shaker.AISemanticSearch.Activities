    <ui:InvokeCode ContinueOnError="{x:Null}" Code="' ================================================================&#xA;' ChunkText  (PRIVATE - used by IngestDocuments)&#xA;' Splits ONE document's text into overlapping character windows.&#xA;' Character-based on purpose: no tokenizer dependency, predictable,&#xA;' language-agnostic. ~1000 chars ~= 250-400 tokens. Overlap keeps&#xA;' context across seams so a straddling answer still surfaces.&#xA;' Returns trimmed chunks in order, no empties. Caller assigns the&#xA;' chunk_index from list position.&#xA;' On failure: out_Success=False + out_ErrorMessage; out_Chunks stays&#xA;' an empty (non-null) list so the caller never NREs.&#xA;' Structured path note: structured rows are NOT chunked (each row's&#xA;' JSON is one atomic unit), so this helper is free-text-path only.&#xA;' ================================================================&#xA;&#xA;out_Success = False&#xA;out_ErrorMessage = &quot;&quot;&#xA;out_Chunks = New System.Collections.Generic.List(Of String)()&#xA;&#xA;Try&#xA;    ' Nothing/blank in -&gt; empty list out. The If-wrap also avoids a null&#xA;    ' reference on text.Length below.&#xA;    If Not String.IsNullOrWhiteSpace(in_Text) Then&#xA;&#xA;        Dim text As String = in_Text&#xA;        Dim n As Integer = text.Length&#xA;&#xA;        ' Guard the knobs so the loop ALWAYS moves forward:&#xA;        Dim size As Integer = Math.Max(1, in_ChunkSize)&#xA;        Dim overlap As Integer = in_Overlap&#xA;        If overlap &lt; 0 Then overlap = 0&#xA;        If overlap &gt; size - 1 Then overlap = size - 1   ' overlap must be &lt; size&#xA;&#xA;        Dim startPos As Integer = 0&#xA;        Do While startPos &lt; n&#xA;            Dim endPos As Integer = Math.Min(startPos + size, n)&#xA;&#xA;            ' --- optional: snap the cut back to whitespace so we don't split&#xA;            '     a word. Delete this block for a pure fixed window. ----------&#xA;            If endPos &lt; n Then&#xA;                Dim probe As Integer = endPos&#xA;                Do While probe &gt; startPos AndAlso Not Char.IsWhiteSpace(text(probe - 1))&#xA;                    probe -= 1&#xA;                Loop&#xA;                ' only accept the snap if it still leaves a reasonably full chunk&#xA;                If probe &gt; startPos + (size \ 2) Then&#xA;                    endPos = probe&#xA;                End If&#xA;            End If&#xA;            ' ----------------------------------------------------------------&#xA;&#xA;            Dim piece As String = text.Substring(startPos, endPos - startPos).Trim()&#xA;            If piece.Length &gt; 0 Then&#xA;                out_Chunks.Add(piece)&#xA;            End If&#xA;&#xA;            If endPos &gt;= n Then&#xA;                Exit Do&#xA;            End If&#xA;&#xA;            ' Advance, keeping 'overlap' chars of the previous window.&#xA;            Dim nextStart As Integer = endPos - overlap&#xA;            If nextStart &lt;= startPos Then&#xA;                nextStart = endPos                       ' safety: never stall&#xA;            End If&#xA;            startPos = nextStart&#xA;        Loop&#xA;&#xA;    End If&#xA;&#xA;    out_Success = True&#xA;&#xA;Catch ex As System.Exception&#xA;    out_Success = False&#xA;    out_ErrorMessage = &quot;ChunkText failed: &quot; &amp; ex.Message&#xA;    If ex.InnerException IsNot Nothing Then&#xA;        out_ErrorMessage &amp;= &quot; | Inner: &quot; &amp; ex.InnerException.Message&#xA;    End If&#xA;End Try&#xA;" DisplayName="Invoke Code - ChunkText" sap:VirtualizedContainerService.HintSize="450,197" sap2010:WorkflowViewState.IdRef="InvokeCode_2">
