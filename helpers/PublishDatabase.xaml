    <ui:InvokeCode ContinueOnError="{x:Null}" Code="' ================================================================&#xA;' PublishDatabase  (PRIVATE - called inside the write lock)&#xA;' Makes the just-written LOCAL db the new canonical db on the share,&#xA;' WITHOUT ever running the engine over the share.&#xA;' Steps: copy local -&gt; store.db.new (a full, complete file), then&#xA;' atomically RENAME store.db.new -&gt; store.db. Rename-replace is atomic&#xA;' on the file server, so any reader sees either the whole old db or the&#xA;' whole new db - never a half-written file. This is the corruption guard.&#xA;' WAL note: we checkpoint+close in the ingest step BEFORE this runs, so&#xA;' the local store.db is self-contained and the -wal/-shm side files are&#xA;' already folded in. We copy ONLY store.db.&#xA;' Structured note: the file already contains chunk_fields; publishing is&#xA;' a whole-file copy/rename, so it is format-agnostic - no change needed.&#xA;' On failure: out_Success=False + out_ErrorMessage (a leftover .new is&#xA;' harmless; the next run's Copy overwrites it).&#xA;' ================================================================&#xA;&#xA;out_Success = False&#xA;out_ErrorMessage = &quot;&quot;&#xA;&#xA;Try&#xA;    Dim newPath As String = in_SharePath &amp; &quot;.new&quot;&#xA;    Dim maxAttempts As Integer = 3&#xA;    Dim attempt As Integer = 0&#xA;&#xA;    ' A reader mid-copy can briefly hold the share file open, which makes&#xA;    ' Replace fail transiently - retry a few times before giving up.&#xA;    Do&#xA;        attempt += 1&#xA;        Try&#xA;            ' 1) Copy the complete local db to a temp name on the share.&#xA;            '    Overwrite any leftover .new from a previously failed run.&#xA;            System.IO.File.Copy(in_LocalDbPath, newPath, True)&#xA;&#xA;            ' 2) Atomically swap it into place.&#xA;            If System.IO.File.Exists(in_SharePath) Then&#xA;                ' Replace keeps the swap atomic and hands back no backup file (Nothing).&#xA;                System.IO.File.Replace(newPath, in_SharePath, Nothing)&#xA;            Else&#xA;                ' First publish ever - nothing to replace, just name it.&#xA;                System.IO.File.Move(newPath, in_SharePath)&#xA;            End If&#xA;            Exit Do&#xA;        Catch ioEx As System.IO.IOException&#xA;            If attempt &gt;= maxAttempts Then Throw&#xA;            System.Threading.Thread.Sleep(750 * attempt)&#xA;        End Try&#xA;    Loop&#xA;&#xA;    out_Success = True&#xA;&#xA;Catch ex As System.Exception&#xA;    out_Success = False&#xA;    out_ErrorMessage = &quot;PublishDatabase failed (local='&quot; &amp; in_LocalDbPath &amp;&#xA;        &quot;', share='&quot; &amp; in_SharePath &amp; &quot;'): &quot; &amp; ex.Message&#xA;    If ex.InnerException IsNot Nothing Then&#xA;        out_ErrorMessage &amp;= &quot; | Inner: &quot; &amp; ex.InnerException.Message&#xA;    End If&#xA;End Try&#xA;" DisplayName="Invoke Code - PublishDatabase" sap:VirtualizedContainerService.HintSize="450,197" sap2010:WorkflowViewState.IdRef="InvokeCode_2">
