    <ui:InvokeCode ContinueOnError="{x:Null}" Code="' EnsureSqliteNative - idempotent. Copies the bundled native engine next to&#xA;' the running process (app base dir) the first time on any machine, then&#xA;' registers the SQLitePCLRaw provider. No-op on every subsequent call.&#xA;Try&#xA;    Dim baseDir As String = System.AppDomain.CurrentDomain.BaseDirectory&#xA;    Dim target As String = System.IO.Path.Combine(baseDir, &quot;e_sqlite3.dll&quot;)&#xA;    If Not System.IO.File.Exists(target) Then&#xA;        ' Probe candidate roots: design-time project dir, process base dir,&#xA;        ' and the installed package folder of this library (via its loaded&#xA;        ' assembly). Environment.CurrentDirectory alone is not reliable when&#xA;        ' the library runs inside a consuming process.&#xA;        Dim candidates As New System.Collections.Generic.List(Of String)&#xA;        candidates.Add(System.IO.Path.Combine(Environment.CurrentDirectory, &quot;lib\e_sqlite3.dll&quot;))&#xA;        candidates.Add(System.IO.Path.Combine(baseDir, &quot;lib\e_sqlite3.dll&quot;))&#xA;        For Each asm As System.Reflection.Assembly In System.AppDomain.CurrentDomain.GetAssemblies()&#xA;            Try&#xA;                If Not asm.IsDynamic AndAlso Not String.IsNullOrEmpty(asm.Location) AndAlso asm.GetName().Name.StartsWith(&quot;AI_SemanticSearch&quot;) Then&#xA;                    Dim asmDir As String = System.IO.Path.GetDirectoryName(asm.Location)&#xA;                    candidates.Add(System.IO.Path.Combine(asmDir, &quot;lib\e_sqlite3.dll&quot;))&#xA;                    candidates.Add(System.IO.Path.Combine(asmDir, &quot;e_sqlite3.dll&quot;))&#xA;                    candidates.Add(System.IO.Path.GetFullPath(System.IO.Path.Combine(asmDir, &quot;..\..\lib\e_sqlite3.dll&quot;)))&#xA;                End If&#xA;            Catch&#xA;            End Try&#xA;        Next&#xA;        For Each src As String In candidates&#xA;            If System.IO.File.Exists(src) Then&#xA;                System.IO.File.Copy(src, target, True)&#xA;                Exit For&#xA;            End If&#xA;        Next&#xA;    End If&#xA;    SQLitePCL.Batteries_V2.Init()&#xA;    out_Success = True&#xA;    out_ErrorMessage = &quot;&quot;&#xA;Catch ex As System.Exception&#xA;    out_Success = False&#xA;    out_ErrorMessage = &quot;EnsureSqliteNative failed: &quot; &amp; ex.ToString()&#xA;End Try" DisplayName="Invoke Code - Ensure Sqlite Native" sap:VirtualizedContainerService.HintSize="450,197" sap2010:WorkflowViewState.IdRef="InvokeCode_1">
