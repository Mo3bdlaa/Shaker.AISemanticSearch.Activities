    <ui:LogMessage DisplayName="Log Message" sap:VirtualizedContainerService.HintSize="450,175" sap2010:WorkflowViewState.IdRef="LogMessage_1" Message="[&quot;Checking If Current Doc changed before reingesting...&quot;]" />
    <ui:InvokeCode ContinueOnError="{x:Null}" Code="' ================================================================&#xA;' CheckDocument  (PRIVATE - used by IngestDocuments)&#xA;' Computes a content hash of the doc text and compares it to what's&#xA;' already stored. out_NeedsWrite is True only if the doc is new OR its&#xA;' text changed - that's what makes re-ingesting the same batch cheap.&#xA;' Works for free-text AND structured rows: for a structured row in_Text&#xA;' is the row JSON, so an unchanged row hashes equal and is skipped.&#xA;' On failure: sets out_Success=False + out_ErrorMessage, and leaves&#xA;' out_NeedsWrite=False so we never request a write we couldn't validate.&#xA;' ================================================================&#xA;&#xA;out_Success = False&#xA;out_ErrorMessage = &quot;&quot;&#xA;out_NewHash = &quot;&quot;&#xA;out_NeedsWrite = False&#xA;&#xA;Try&#xA;    ' --- hash the incoming text (SHA256 -&gt; lowercase hex) ----------&#xA;    Dim newHash As String&#xA;    Using sha As System.Security.Cryptography.SHA256 = System.Security.Cryptography.SHA256.Create()&#xA;        Dim raw As Byte() = System.Text.Encoding.UTF8.GetBytes(If(in_Text, &quot;&quot;))&#xA;        Dim hb As Byte() = sha.ComputeHash(raw)&#xA;        newHash = System.BitConverter.ToString(hb).Replace(&quot;-&quot;, &quot;&quot;).ToLowerInvariant()&#xA;    End Using&#xA;    out_NewHash = newHash&#xA;&#xA;    ' --- read the stored hash for this doc, if it exists -----------&#xA;    Dim stored As String = Nothing&#xA;    Using conn As New Microsoft.Data.Sqlite.SqliteConnection(&quot;Data Source=&quot; &amp; in_DbPath &amp; &quot;;Pooling=False&quot;)&#xA;        conn.Open()&#xA;        Using cmd As Microsoft.Data.Sqlite.SqliteCommand = conn.CreateCommand()&#xA;            cmd.CommandText = &quot;SELECT content_hash FROM documents WHERE doc_id=$id LIMIT 1;&quot;&#xA;            cmd.Parameters.AddWithValue(&quot;$id&quot;, in_DocId)&#xA;            Dim r As Object = cmd.ExecuteScalar()           ' Nothing if no row&#xA;            If r IsNot Nothing AndAlso Not (TypeOf r Is System.DBNull) Then&#xA;                stored = r.ToString()&#xA;            End If&#xA;        End Using&#xA;        conn.Close()&#xA;    End Using&#xA;&#xA;    ' New doc, or text changed -&gt; needs writing.&#xA;    out_NeedsWrite = (stored Is Nothing) OrElse (Not String.Equals(stored, newHash, StringComparison.Ordinal))&#xA;&#xA;    out_Success = True&#xA;&#xA;Catch ex As System.Exception&#xA;    ' Could not determine change state (locked db, bad path, etc.).&#xA;    ' Signal failure and DO NOT request a write we couldn't validate.&#xA;    out_Success = False&#xA;    out_NeedsWrite = False&#xA;    out_ErrorMessage = &quot;CheckDocument failed for doc '&quot; &amp; in_DocId &amp; &quot;': &quot; &amp; ex.Message&#xA;    If ex.InnerException IsNot Nothing Then&#xA;        out_ErrorMessage &amp;= &quot; | Inner: &quot; &amp; ex.InnerException.Message&#xA;    End If&#xA;End Try&#xA;" DisplayName="Invoke Code - CheckDocument" sap:VirtualizedContainerService.HintSize="450,197" sap2010:WorkflowViewState.IdRef="InvokeCode_2">
