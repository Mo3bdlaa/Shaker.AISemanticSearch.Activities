  <Sequence sap2010:Annotation.AnnotationText="Decides whether a document needs (re)writing, so you don't waste embedding calls on unchanged docs. " DisplayName="CheckDocument" sap:VirtualizedContainerService.HintSize="1081,813.6566666666666" sap2010:WorkflowViewState.IdRef="Sequence_1">
