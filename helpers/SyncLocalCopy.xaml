    <ui:InvokeCode ContinueOnError="{x:Null}" Code="' ================================================================&#xA;' SyncLocalCopy  (PRIVATE - called at start of retrieval)&#xA;' Ensures this machine has the latest committed db LOCALLY, then hands&#xA;' back the local path to open. Readers NEVER open the share directly.&#xA;' Copy-on-change: only copy when the share's file is newer, so most&#xA;' retrievals pay nothing. Whole-file copy over SMB is safe; running the&#xA;' engine over SMB is not - that's the line we never cross.&#xA;' Structured note: the file carries chunk_fields too; copying is&#xA;' format-agnostic, so nothing changes for the structured path.&#xA;' Reads are never blocked by writers: if the share or the local copy is&#xA;' briefly held (a publish in progress, an AV scan, another reader), we&#xA;' retry with an interval instead of failing the retrieval.&#xA;' On failure: out_Success=False + out_ErrorMessage; caller aborts the&#xA;' retrieval (Check-True). out_LocalDbPath is still set for completeness.&#xA;' ================================================================&#xA;&#xA;out_Success = False&#xA;out_ErrorMessage = &quot;&quot;&#xA;out_LocalDbPath = in_LocalDbPath&#xA;&#xA;Try&#xA;    ' If the share file is missing, surface a clear error rather than a&#xA;    ' confusing SQLite &quot;file is not a database&quot; later.&#xA;    If Not System.IO.File.Exists(in_SharePath) Then&#xA;        Throw New System.Exception(&quot;Canonical database not found on share: &quot; &amp; in_SharePath)&#xA;    End If&#xA;&#xA;    Dim needCopy As Boolean = True&#xA;    If System.IO.File.Exists(in_LocalDbPath) Then&#xA;        Dim shareTime As DateTime = System.IO.File.GetLastWriteTimeUtc(in_SharePath)&#xA;        Dim localTime As DateTime = System.IO.File.GetLastWriteTimeUtc(in_LocalDbPath)&#xA;        ' Only refresh if the share has a strictly newer version.&#xA;        If shareTime &lt;= localTime Then&#xA;            needCopy = False&#xA;        End If&#xA;    End If&#xA;&#xA;    If needCopy Then&#xA;        Dim localDir As String = System.IO.Path.GetDirectoryName(in_LocalDbPath)&#xA;        If Not String.IsNullOrEmpty(localDir) AndAlso Not System.IO.Directory.Exists(localDir) Then&#xA;            System.IO.Directory.CreateDirectory(localDir)&#xA;        End If&#xA;        Dim deadline As DateTime = DateTime.UtcNow.AddMilliseconds(30000)&#xA;        Dim lastErr As System.Exception = Nothing&#xA;        Dim done As Boolean = False&#xA;        Do&#xA;            Try&#xA;                ' Copy to a temp local name then move into place, so a reader on&#xA;                ' THIS machine never opens a half-copied file either.&#xA;                Dim tmp As String = in_LocalDbPath &amp; &quot;.tmp&quot;&#xA;                System.IO.File.Copy(in_SharePath, tmp, True)&#xA;                ' Stale WAL side-files of the OLD local copy must not be&#xA;                ' replayed onto the new file - clear them before the swap.&#xA;                For Each ext As String In New String() {&quot;-wal&quot;, &quot;-shm&quot;}&#xA;                    Dim side As String = in_LocalDbPath &amp; ext&#xA;                    If System.IO.File.Exists(side) Then System.IO.File.Delete(side)&#xA;                Next&#xA;                If System.IO.File.Exists(in_LocalDbPath) Then&#xA;                    System.IO.File.Replace(tmp, in_LocalDbPath, Nothing)&#xA;                Else&#xA;                    System.IO.File.Move(tmp, in_LocalDbPath)&#xA;                End If&#xA;                done = True&#xA;            Catch ioex As System.IO.IOException&#xA;                ' Publish in progress or copy briefly held - wait, then retry.&#xA;                lastErr = ioex&#xA;                System.Threading.Thread.Sleep(1000)&#xA;            Catch uaex As System.UnauthorizedAccessException&#xA;                lastErr = uaex&#xA;                System.Threading.Thread.Sleep(1000)&#xA;            End Try&#xA;        Loop Until done OrElse DateTime.UtcNow &gt;= deadline&#xA;        If Not done Then&#xA;            Dim detail As String = &quot;&quot;&#xA;            If lastErr IsNot Nothing Then detail = &quot; Last error: &quot; &amp; lastErr.Message&#xA;            Throw New System.Exception(&quot;Could not refresh local copy after 30000ms of retries.&quot; &amp; detail)&#xA;        End If&#xA;    End If&#xA;&#xA;    out_Success = True&#xA;&#xA;Catch ex As System.Exception&#xA;    out_Success = False&#xA;    out_ErrorMessage = &quot;SyncLocalCopy failed (share='&quot; &amp; in_SharePath &amp;&#xA;        &quot;', local='&quot; &amp; in_LocalDbPath &amp; &quot;'): &quot; &amp; ex.Message&#xA;    If ex.InnerException IsNot Nothing Then&#xA;        out_ErrorMessage &amp;= &quot; | Inner: &quot; &amp; ex.InnerException.Message&#xA;    End If&#xA;End Try&#xA;" DisplayName="Invoke Code - SyncLocalCopy" sap:VirtualizedContainerService.HintSize="450,197" sap2010:WorkflowViewState.IdRef="InvokeCode_2">
