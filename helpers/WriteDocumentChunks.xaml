    <ui:InvokeCode ContinueOnError="{x:Null}" Code="' ================================================================&#xA;' WriteDocumentChunks  (PRIVATE — used by IngestDocuments)&#xA;' Writes ONE document's chunks in a single transaction:&#xA;'   1) delete this doc's old chunks (re-ingest replaces cleanly)&#xA;'   2) upsert the documents row (with the new hash)&#xA;'   3) insert each chunk + its embedding as a Float32 BLOB&#xA;' Embeddings arrive unit-normalized as Double(); we store them as&#xA;' Float32 (half the bytes, precision loss negligible after norm).&#xA;' Cosine downstream is just a dot product over these.&#xA;'&#xA;' in_Metadata: optional row JSON stored on every chunk of this doc&#xA;'   (used by the structured path). Pass &quot;&quot; for the free-text path.&#xA;' On failure: rolls back, sets out_Success=False + out_ErrorMessage,&#xA;'   and does NOT throw, so IngestDocuments can count it and continue.&#xA;' ================================================================&#xA;&#xA;out_Success = False&#xA;out_ErrorMessage = &quot;&quot;&#xA;&#xA;Try&#xA;    If in_Chunks.Count &lt;&gt; in_Embeddings.Count Then&#xA;        Throw New System.Exception(&quot;Chunk/embedding count mismatch: &quot; &amp;&#xA;            in_Chunks.Count.ToString() &amp; &quot; vs &quot; &amp; in_Embeddings.Count.ToString())&#xA;    End If&#xA;&#xA;    ' Normalize the optional metadata once (never bind Nothing).&#xA;    Dim meta As String = If(in_Metadata, &quot;&quot;)&#xA;&#xA;    Dim nowUtc As String = DateTime.UtcNow.ToString(&quot;o&quot;)&#xA;&#xA;    Using conn As New Microsoft.Data.Sqlite.SqliteConnection(&quot;Data Source=&quot; &amp; in_DbPath &amp; &quot;;Pooling=False&quot;)&#xA;        conn.Open()&#xA;&#xA;        ' Defensive even though the cross-machine lock means single writer.&#xA;        Using p As Microsoft.Data.Sqlite.SqliteCommand = conn.CreateCommand()&#xA;            p.CommandText = &quot;PRAGMA busy_timeout=5000;&quot;&#xA;            p.ExecuteNonQuery()&#xA;        End Using&#xA;&#xA;        Using txn As Microsoft.Data.Sqlite.SqliteTransaction = conn.BeginTransaction()&#xA;&#xA;            ' 1) clear old chunks for this doc&#xA;            Using cmd As Microsoft.Data.Sqlite.SqliteCommand = conn.CreateCommand()&#xA;                cmd.Transaction = txn&#xA;                cmd.CommandText = &quot;DELETE FROM chunks WHERE doc_id=$id;&quot;&#xA;                cmd.Parameters.AddWithValue(&quot;$id&quot;, in_DocId)&#xA;                cmd.ExecuteNonQuery()&#xA;            End Using&#xA;&#xA;            ' 2) upsert the documents row&#xA;            Using cmd As Microsoft.Data.Sqlite.SqliteCommand = conn.CreateCommand()&#xA;                cmd.Transaction = txn&#xA;                cmd.CommandText =&#xA;                    &quot;INSERT INTO documents(doc_id,source,content_hash,created_utc,updated_utc) &quot; &amp;&#xA;                    &quot;VALUES($id,$src,$hash,$now,$now) &quot; &amp;&#xA;                    &quot;ON CONFLICT(doc_id) DO UPDATE SET &quot; &amp;&#xA;                    &quot;  source=$src, content_hash=$hash, updated_utc=$now;&quot;&#xA;                cmd.Parameters.AddWithValue(&quot;$id&quot;, in_DocId)&#xA;                cmd.Parameters.AddWithValue(&quot;$src&quot;, If(in_Source, &quot;&quot;))   ' never bind Nothing&#xA;                cmd.Parameters.AddWithValue(&quot;$hash&quot;, in_ContentHash)&#xA;                cmd.Parameters.AddWithValue(&quot;$now&quot;, nowUtc)&#xA;                cmd.ExecuteNonQuery()&#xA;            End Using&#xA;&#xA;            ' 3) insert chunks — ONE command, re-bound per row (fast + clean)&#xA;            Using cmd As Microsoft.Data.Sqlite.SqliteCommand = conn.CreateCommand()&#xA;                cmd.Transaction = txn&#xA;                cmd.CommandText =&#xA;                    &quot;INSERT INTO chunks(doc_id,chunk_index,content,embedding,dim,model,content_hash,metadata,created_utc) &quot; &amp;&#xA;                    &quot;VALUES($id,$ix,$content,$emb,$dim,$model,$hash,$meta,$now);&quot;&#xA;&#xA;                ' declare the parameters once, set Value each iteration&#xA;                Dim pId   = cmd.Parameters.Add(&quot;$id&quot;,      Microsoft.Data.Sqlite.SqliteType.Text)&#xA;                Dim pIx   = cmd.Parameters.Add(&quot;$ix&quot;,      Microsoft.Data.Sqlite.SqliteType.Integer)&#xA;                Dim pCont = cmd.Parameters.Add(&quot;$content&quot;, Microsoft.Data.Sqlite.SqliteType.Text)&#xA;                Dim pEmb  = cmd.Parameters.Add(&quot;$emb&quot;,     Microsoft.Data.Sqlite.SqliteType.Blob)&#xA;                Dim pDim  = cmd.Parameters.Add(&quot;$dim&quot;,     Microsoft.Data.Sqlite.SqliteType.Integer)&#xA;                Dim pMod  = cmd.Parameters.Add(&quot;$model&quot;,   Microsoft.Data.Sqlite.SqliteType.Text)&#xA;                Dim pHash = cmd.Parameters.Add(&quot;$hash&quot;,    Microsoft.Data.Sqlite.SqliteType.Text)&#xA;                Dim pMeta = cmd.Parameters.Add(&quot;$meta&quot;,    Microsoft.Data.Sqlite.SqliteType.Text)&#xA;                Dim pNow  = cmd.Parameters.Add(&quot;$now&quot;,     Microsoft.Data.Sqlite.SqliteType.Text)&#xA;&#xA;                For c As Integer = 0 To in_Chunks.Count - 1&#xA;                    Dim vec As Double() = in_Embeddings(c)&#xA;&#xA;                    ' guard: every vector must match the store's dimension&#xA;                    If vec.Length &lt;&gt; in_Dim Then&#xA;                        Throw New System.Exception(&quot;Dimension mismatch on chunk &quot; &amp; c.ToString() &amp;&#xA;                            &quot;: got &quot; &amp; vec.Length.ToString() &amp; &quot;, expected &quot; &amp; in_Dim.ToString())&#xA;                    End If&#xA;&#xA;                    ' pack Double() -&gt; Float32 -&gt; bytes (4 bytes per value)&#xA;                    Dim fvec(vec.Length - 1) As Single&#xA;                    For k As Integer = 0 To vec.Length - 1&#xA;                        fvec(k) = CSng(vec(k))&#xA;                    Next&#xA;                    Dim bytes(vec.Length * 4 - 1) As Byte&#xA;                    System.Buffer.BlockCopy(fvec, 0, bytes, 0, bytes.Length)&#xA;&#xA;                    pId.Value   = in_DocId&#xA;                    pIx.Value   = c&#xA;                    pCont.Value = in_Chunks(c)&#xA;                    pEmb.Value  = bytes&#xA;                    pDim.Value  = in_Dim&#xA;                    pMod.Value  = in_Model&#xA;                    pHash.Value = in_ContentHash&#xA;                    pMeta.Value = meta&#xA;                    pNow.Value  = nowUtc&#xA;                    cmd.ExecuteNonQuery()&#xA;                Next&#xA;            End Using&#xA;&#xA;            txn.Commit()        ' all-or-nothing for this document&#xA;        End Using&#xA;&#xA;        conn.Close()&#xA;    End Using&#xA;&#xA;    out_Success = True&#xA;&#xA;Catch ex As System.Exception&#xA;    ' Transaction auto-rolls-back when the Using block disposes without a&#xA;    ' commit, so a failure here leaves the store untouched for this doc.&#xA;    out_Success = False&#xA;    out_ErrorMessage = &quot;WriteDocumentChunks failed for doc '&quot; &amp; in_DocId &amp; &quot;': &quot; &amp; ex.Message&#xA;    If ex.InnerException IsNot Nothing Then&#xA;        out_ErrorMessage &amp;= &quot; | Inner: &quot; &amp; ex.InnerException.Message&#xA;    End If&#xA;End Try" DisplayName="Invoke Code - Write Document Chunks" sap:VirtualizedContainerService.HintSize="450,197" sap2010:WorkflowViewState.IdRef="InvokeCode_1">
