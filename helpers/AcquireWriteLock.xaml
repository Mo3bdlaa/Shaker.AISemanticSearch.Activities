    <ui:InvokeCode ContinueOnError="{x:Null}" Code="' ================================================================&#xA;' AcquireWriteLock&#xA;' Cross-machine single-writer gate. The LOCK IS THE HELD HANDLE,&#xA;' not the file's existence. While we keep out_LockStream open with&#xA;' FileShare.None, no other machine can open it -&gt; they wait.&#xA;' If we crash, the OS/SMB server releases the handle automatically,&#xA;' so the next writer gets in. No stale-file cleanup needed.&#xA;' out_LockStream MUST stay open until ReleaseWriteLock - do NOT wrap&#xA;' it in Using here; it has to survive across activities as a variable.&#xA;'&#xA;' FAILURE MODEL (IMPORTANT): a timeout is NOT an exception here - it is&#xA;' an expected &quot;someone else is writing&quot; outcome. We DO NOT throw; we set&#xA;' out_Success=False and leave out_LockStream=Nothing. THE CALLER MUST&#xA;' check out_Success and ABORT the ingest when it is False - never write&#xA;' without a held lock.&#xA;' ================================================================&#xA;&#xA;out_Success = False&#xA;out_ErrorMessage = &quot;&quot;&#xA;out_LockStream = Nothing&#xA;&#xA;Try&#xA;    ' Make sure the folder on the share exists (harmless if it already does).&#xA;    Dim lockDir As String = System.IO.Path.GetDirectoryName(in_LockPath)&#xA;    If Not String.IsNullOrEmpty(lockDir) AndAlso Not System.IO.Directory.Exists(lockDir) Then&#xA;        System.IO.Directory.CreateDirectory(lockDir)&#xA;    End If&#xA;&#xA;    Dim deadlineUtc As DateTime = DateTime.UtcNow.AddMilliseconds(in_TimeoutMs)&#xA;    Dim lastError As String = &quot;&quot;&#xA;&#xA;    Do&#xA;        Try&#xA;            ' OpenOrCreate: opens the existing lock file (or makes it) ...&#xA;            ' FileShare.None: ... and denies everyone else. THIS is the lock.&#xA;            out_LockStream = New System.IO.FileStream(&#xA;                in_LockPath,&#xA;                System.IO.FileMode.OpenOrCreate,&#xA;                System.IO.FileAccess.ReadWrite,&#xA;                System.IO.FileShare.None)&#xA;&#xA;            ' Stamp who holds it, purely for humans reading the file later.&#xA;            Dim stamp As Byte() = System.Text.Encoding.UTF8.GetBytes(&#xA;                in_OwnerInfo &amp; &quot; @ &quot; &amp; DateTime.UtcNow.ToString(&quot;o&quot;))&#xA;            out_LockStream.SetLength(0)           ' clear any previous owner's stamp&#xA;            out_LockStream.Write(stamp, 0, stamp.Length)&#xA;            out_LockStream.Flush()&#xA;&#xA;            out_Success = True&#xA;            Exit Do                                ' acquired - leave the loop&#xA;&#xA;        Catch ioEx As System.IO.IOException&#xA;            ' Almost always &quot;file in use&quot; = someone else holds the lock.&#xA;            ' (A bad path/permission also lands here and surfaces as the&#xA;            '  timeout message once the deadline passes.)&#xA;            lastError = ioEx.Message&#xA;            If DateTime.UtcNow &gt;= deadlineUtc Then&#xA;                ' Timed out waiting for the holder to release. Signal via the&#xA;                ' flag, DO NOT throw, and leave no half-open handle.&#xA;                out_ErrorMessage =&#xA;                    &quot;Could not acquire write lock within &quot; &amp; in_TimeoutMs.ToString() &amp;&#xA;                    &quot; ms. Last error: &quot; &amp; lastError&#xA;                out_LockStream = Nothing&#xA;                Exit Do&#xA;            End If&#xA;            System.Threading.Thread.Sleep(in_RetryDelayMs)&#xA;        End Try&#xA;    Loop&#xA;&#xA;Catch ex As System.Exception&#xA;    ' Unexpected failure (bad path, permissions, disk). Same flag contract.&#xA;    out_Success = False&#xA;    out_ErrorMessage = &quot;AcquireWriteLock failed for '&quot; &amp; in_LockPath &amp; &quot;': &quot; &amp; ex.Message&#xA;    If ex.InnerException IsNot Nothing Then&#xA;        out_ErrorMessage &amp;= &quot; | Inner: &quot; &amp; ex.InnerException.Message&#xA;    End If&#xA;    ' Never leave a partially-opened handle behind.&#xA;    Try&#xA;        If out_LockStream IsNot Nothing Then out_LockStream.Dispose()&#xA;    Catch&#xA;    End Try&#xA;    out_LockStream = Nothing&#xA;End Try&#xA;" DisplayName="Invoke Code - AcquireWriteLock" sap:VirtualizedContainerService.HintSize="450,197" sap2010:WorkflowViewState.IdRef="InvokeCode_2">
