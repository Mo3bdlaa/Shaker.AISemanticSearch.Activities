                  <ui:InvokeCode ContinueOnError="{x:Null}" Code="' FilterUnchanged - drop docs whose content is identical to what the store&#xA;' already holds, so re-runs embed and write NOTHING for unchanged docs.&#xA;' Doc identity: DOC-LEVEL hash = SHA256 over all row ContentJson values in&#xA;' row order, LF-joined. NOTE: formula must match pass 0 of&#xA;' WriteStructuredChunks - if they drift, docs are always rewritten (safe).&#xA;' Contract: sets out_Success/out_ErrorMessage; the CheckTrue after throws.&#xA;out_Success = False&#xA;out_ErrorMessage = &quot;&quot;&#xA;out_SkippedDocs = 0&#xA;Try&#xA;&#xA;Dim docBuf As New System.Collections.Generic.Dictionary(Of String, System.Text.StringBuilder)()&#xA;For Each r As System.Data.DataRow In in_Rows.Rows&#xA;    Dim id As String = r(&quot;DocId&quot;).ToString()&#xA;    If Not docBuf.ContainsKey(id) Then docBuf(id) = New System.Text.StringBuilder()&#xA;    docBuf(id).Append(r(&quot;ContentJson&quot;).ToString()).Append(Convert.ToChar(10))&#xA;Next&#xA;&#xA;' Fold the field-mode configuration into the doc hash, so changing which&#xA;' columns are exact vs semantic triggers a rewrite (content alone would skip).&#xA;' NOTE: signature formula must match pass 0 of WriteStructuredChunks.&#xA;Dim docByRow As New System.Collections.Generic.Dictionary(Of Integer, String)()&#xA;For Each r As System.Data.DataRow In in_Rows.Rows&#xA;    docByRow(CInt(r(&quot;RowKey&quot;))) = r(&quot;DocId&quot;).ToString()&#xA;Next&#xA;Dim modeSig As New System.Collections.Generic.Dictionary(Of String, System.Collections.Generic.SortedSet(Of String))()&#xA;For Each f As System.Data.DataRow In in_Fields.Rows&#xA;    Dim did As String = Nothing&#xA;    If docByRow.TryGetValue(CInt(f(&quot;RowKey&quot;)), did) Then&#xA;        If Not modeSig.ContainsKey(did) Then modeSig(did) = New System.Collections.Generic.SortedSet(Of String)(StringComparer.Ordinal)&#xA;        modeSig(did).Add(f(&quot;FieldKey&quot;).ToString() &amp; &quot;:&quot; &amp; f(&quot;Mode&quot;).ToString().ToLowerInvariant())&#xA;    End If&#xA;Next&#xA;For Each kv As System.Collections.Generic.KeyValuePair(Of String, System.Text.StringBuilder) In docBuf&#xA;    Dim sig As String = &quot;&quot;&#xA;    If modeSig.ContainsKey(kv.Key) Then sig = String.Join(&quot;;&quot;, modeSig(kv.Key))&#xA;    kv.Value.Append(&quot;|modes|&quot;).Append(sig)&#xA;Next&#xA;&#xA;Dim docHash As New System.Collections.Generic.Dictionary(Of String, String)()&#xA;Using sha As System.Security.Cryptography.SHA256 = System.Security.Cryptography.SHA256.Create()&#xA;    For Each kv As System.Collections.Generic.KeyValuePair(Of String, System.Text.StringBuilder) In docBuf&#xA;        Dim hb As Byte() = sha.ComputeHash(System.Text.Encoding.UTF8.GetBytes(kv.Value.ToString()))&#xA;        docHash(kv.Key) = System.BitConverter.ToString(hb).Replace(&quot;-&quot;, &quot;&quot;).ToLowerInvariant()&#xA;    Next&#xA;End Using&#xA;&#xA;Dim unchanged As New System.Collections.Generic.HashSet(Of String)()&#xA;If System.IO.File.Exists(in_DbPath) Then&#xA;    Using conn As New Microsoft.Data.Sqlite.SqliteConnection(&quot;Data Source=&quot; &amp; in_DbPath &amp; &quot;;Pooling=False&quot;)&#xA;        conn.Open()&#xA;        For Each kv As System.Collections.Generic.KeyValuePair(Of String, String) In docHash&#xA;            Using cmd As Microsoft.Data.Sqlite.SqliteCommand = conn.CreateCommand()&#xA;                cmd.CommandText = &quot;SELECT content_hash FROM documents WHERE doc_id=$id LIMIT 1;&quot;&#xA;                cmd.Parameters.AddWithValue(&quot;$id&quot;, kv.Key)&#xA;                Dim stored As Object = cmd.ExecuteScalar()&#xA;                If stored IsNot Nothing AndAlso Not (TypeOf stored Is System.DBNull) AndAlso String.Equals(stored.ToString(), kv.Value, StringComparison.Ordinal) Then&#xA;                    unchanged.Add(kv.Key)&#xA;                End If&#xA;            End Using&#xA;        Next&#xA;        conn.Close()&#xA;    End Using&#xA;End If&#xA;&#xA;If unchanged.Count &gt; 0 Then&#xA;    Dim dropKeys As New System.Collections.Generic.HashSet(Of Integer)()&#xA;    For i As Integer = in_Rows.Rows.Count - 1 To 0 Step -1&#xA;        If unchanged.Contains(in_Rows.Rows(i)(&quot;DocId&quot;).ToString()) Then&#xA;            dropKeys.Add(CInt(in_Rows.Rows(i)(&quot;RowKey&quot;)))&#xA;            in_Rows.Rows(i).Delete()&#xA;        End If&#xA;    Next&#xA;    in_Rows.AcceptChanges()&#xA;    For i As Integer = in_Fields.Rows.Count - 1 To 0 Step -1&#xA;        If dropKeys.Contains(CInt(in_Fields.Rows(i)(&quot;RowKey&quot;))) Then in_Fields.Rows(i).Delete()&#xA;    Next&#xA;    in_Fields.AcceptChanges()&#xA;End If&#xA;out_SkippedDocs = unchanged.Count&#xA;&#xA;out_Success = True&#xA;Catch ex As System.Exception&#xA;    out_ErrorMessage = &quot;FilterUnchanged failed: &quot; &amp; ex.Message&#xA;    If ex.InnerException IsNot Nothing Then out_ErrorMessage &amp;= &quot; | Inner: &quot; &amp; ex.InnerException.Message&#xA;End Try&#xA;" DisplayName="Invoke Code - FilterUnchanged" sap:VirtualizedContainerService.HintSize="452,197" sap2010:WorkflowViewState.IdRef="InvokeCode_90">
