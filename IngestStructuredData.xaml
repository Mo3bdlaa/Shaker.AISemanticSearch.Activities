                  <ui:InvokeCode ContinueOnError="{x:Null}" Code="' PullForWrite - bring the latest canonical db local so we UPDATE it.&#xA;' First ingest ever: share has no db yet -&gt; skip, and InitializeStore&#xA;' creates a fresh local one.&#xA;' The share lock already serializes robot-vs-robot writes. The LOCAL file&#xA;' can still be briefly held by a previous run's pooled connections, an AV&#xA;' scan, or a reader on this machine - so retry with an interval until&#xA;' in_BudgetMs is exhausted instead of aborting on the first sharing violation.&#xA;' Contract: sets out_Success/out_ErrorMessage; the CheckTrue after throws.&#xA;out_Success = False&#xA;out_ErrorMessage = &quot;&quot;&#xA;Try&#xA;    Dim dir As String = System.IO.Path.GetDirectoryName(in_LocalDbPath)&#xA;    If Not String.IsNullOrEmpty(dir) AndAlso Not System.IO.Directory.Exists(dir) Then&#xA;        System.IO.Directory.CreateDirectory(dir)&#xA;    End If&#xA;    ' Release pooled SQLite handles this executor may still hold on the&#xA;    ' local db from an earlier run - they silently block file deletes.&#xA;    Microsoft.Data.Sqlite.SqliteConnection.ClearAllPools()&#xA;    Dim budgetMs As Integer = in_BudgetMs&#xA;    If budgetMs &lt;= 0 Then budgetMs = 30000&#xA;    Dim deadline As DateTime = DateTime.UtcNow.AddMilliseconds(budgetMs)&#xA;    Dim lastErr As System.Exception = Nothing&#xA;    Dim done As Boolean = False&#xA;    Do&#xA;        Try&#xA;            ' Clear stale WAL side-files or a leftover -wal would be replayed&#xA;            ' onto the freshly-copied db and corrupt our view of it.&#xA;            For Each ext As String In New String() {&quot;-wal&quot;, &quot;-shm&quot;}&#xA;                Dim side As String = in_LocalDbPath &amp; ext&#xA;                If System.IO.File.Exists(side) Then System.IO.File.Delete(side)&#xA;            Next&#xA;            If System.IO.File.Exists(in_SharePath) Then&#xA;                System.IO.File.Copy(in_SharePath, in_LocalDbPath, True)&#xA;            ElseIf System.IO.File.Exists(in_LocalDbPath) Then&#xA;                System.IO.File.Delete(in_LocalDbPath)&#xA;            End If&#xA;            done = True&#xA;        Catch ioex As System.IO.IOException&#xA;            ' Someone still holds the file - wait, then retry.&#xA;            lastErr = ioex&#xA;            Microsoft.Data.Sqlite.SqliteConnection.ClearAllPools()&#xA;            System.Threading.Thread.Sleep(1000)&#xA;        Catch uaex As System.UnauthorizedAccessException&#xA;            lastErr = uaex&#xA;            System.Threading.Thread.Sleep(1000)&#xA;        End Try&#xA;    Loop Until done OrElse DateTime.UtcNow &gt;= deadline&#xA;    If Not done Then&#xA;        Dim detail As String = &quot;&quot;&#xA;        If lastErr IsNot Nothing Then detail = &quot; Last error: &quot; &amp; lastErr.Message&#xA;        Throw New System.Exception(&quot;Local db still in use after &quot; &amp; budgetMs.ToString() &amp; &quot;ms of retries.&quot; &amp; detail)&#xA;    End If&#xA;    out_Success = True&#xA;Catch ex As System.Exception&#xA;    out_ErrorMessage = &quot;PullForWrite failed: &quot; &amp; ex.Message&#xA;    If ex.InnerException IsNot Nothing Then out_ErrorMessage &amp;= &quot; | Inner: &quot; &amp; ex.InnerException.Message&#xA;End Try" DisplayName="Invoke Code - PullForWrite" sap:VirtualizedContainerService.HintSize="452,197" sap2010:WorkflowViewState.IdRef="InvokeCode_1">
