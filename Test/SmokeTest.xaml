    <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" ContinueOnError="{x:Null}" DisplayName="IngestStructuredData.xaml - Invoke Workflow File" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_Smoke_1" UnSafe="False" WorkflowFileName="IngestStructuredData.xaml">
