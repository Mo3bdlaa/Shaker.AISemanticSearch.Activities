        <InArgument x:TypeArguments="x:Int32" x:Key="in_TimeoutSec">[in_TimeoutSec]</InArgument>
        <InArgument x:TypeArguments="x:Int32" x:Key="in_MaxRetries">[in_MaxRetries]</InArgument>
        <InArgument x:TypeArguments="x:Int32" x:Key="in_BatchSize">[in_BatchSize]</InArgument>
        <InArgument x:TypeArguments="sd:DataTable" x:Key="in_dt_Sheet">[dtSheet]</InArgument>
        <InArgument x:TypeArguments="scg:List(x:String)" x:Key="in_ExactColumns">[lsExactColumns]</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_DocIdColumn">docId</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_Source">SmokeTest</InArgument>
        <OutArgument x:TypeArguments="x:Int32" x:Key="out_RowsWritten">[intRowsWritten]</OutArgument>
        <OutArgument x:TypeArguments="scg:List(x:String)" x:Key="out_Errors">[lsIngestErrors]</OutArgument>
      </ui:InvokeWorkflowFile.Arguments>
    </ui:InvokeWorkflowFile>
    <ui:InvokeCode ContinueOnError="{x:Null}" Code="' Ingest must complete without errors. RowsWritten = 0 is legitimate on a&#xA;' second run (skip-unchanged), so only reported errors fail the test.&#xA;out_Success = False&#xA;out_ErrorMessage = &quot;&quot;&#xA;Try&#xA;    If in_Errors IsNot Nothing AndAlso in_Errors.Count &gt; 0 Then&#xA;        Throw New System.Exception(&quot;ingest reported: &quot; &amp; String.Join(&quot; | &quot;, in_Errors.ToArray()))&#xA;    End If&#xA;    out_Success = True&#xA;Catch ex As System.Exception&#xA;    out_ErrorMessage = &quot;AssertIngest failed: &quot; &amp; ex.Message&#xA;End Try&#xA;" DisplayName="Invoke Code - Assert Ingest" sap2010:WorkflowViewState.IdRef="InvokeCode_Smoke_2">
      <ui:InvokeCode.Arguments>
        <InArgument x:TypeArguments="scg:List(x:String)" x:Key="in_Errors">[lsIngestErrors]</InArgument>
        <OutArgument x:TypeArguments="x:Boolean" x:Key="out_Success">[boolSuccess]</OutArgument>
        <OutArgument x:TypeArguments="x:String" x:Key="out_ErrorMessage">[strErrorMessage]</OutArgument>
      </ui:InvokeCode.Arguments>
    </ui:InvokeCode>
    <ui:CheckTrue DisplayName="Check True - Assert Ingest" ErrorMessage="[strErrorMessage]" Expression="[boolSuccess]" sap2010:WorkflowViewState.IdRef="CheckTrue_Smoke_2" />
