    <ui:LogMessage DisplayName="Log Message - Smoke Test Start" sap2010:WorkflowViewState.IdRef="LogMessage_Smoke_1" Message="[&quot;SmokeTest: building in-memory fixture...&quot;]" />
    <ui:InvokeCode ContinueOnError="{x:Null}" Code="' Builds the smoke-test fixture in memory, so the test needs no Excel file&#xA;' and no values baked into the workflow. Two single-row documents:&#xA;'   smoke-1  Rank=5  Harvard University&#xA;'   smoke-2  Rank=9  Stanford University&#xA;' &quot;Rank&quot; is ingested exact and then used as a FILTER at retrieval, so only&#xA;' smoke-1 may come back. &quot;Name&quot; stays semantic.&#xA;out_Success = False&#xA;out_ErrorMessage = &quot;&quot;&#xA;out_Sheet = New System.Data.DataTable()&#xA;out_ExactColumns = New System.Collections.Generic.List(Of String)()&#xA;out_FilterColumns = New System.Collections.Generic.List(Of String)()&#xA;out_QueryJson = &quot;&quot;&#xA;Try&#xA;    out_Sheet.Columns.Add(&quot;docId&quot;, GetType(String))&#xA;    out_Sheet.Columns.Add(&quot;Rank&quot;, GetType(String))&#xA;    out_Sheet.Columns.Add(&quot;Name&quot;, GetType(String))&#xA;    out_Sheet.Rows.Add(&quot;smoke-1&quot;, &quot;5&quot;, &quot;Harvard University&quot;)&#xA;    out_Sheet.Rows.Add(&quot;smoke-2&quot;, &quot;9&quot;, &quot;Stanford University&quot;)&#xA;&#xA;    out_ExactColumns.Add(&quot;docId&quot;)&#xA;    out_ExactColumns.Add(&quot;Rank&quot;)&#xA;    out_FilterColumns.Add(&quot;Rank&quot;)&#xA;&#xA;    ' Name is deliberately a loose match: semantic scoring should still rank it,&#xA;    ' while Rank as a filter must exclude smoke-2 outright.&#xA;    out_QueryJson = &quot;{&quot;&quot;Rank&quot;&quot;:&quot;&quot;5&quot;&quot;,&quot;&quot;Name&quot;&quot;:&quot;&quot;university&quot;&quot;}&quot;&#xA;&#xA;    out_Success = True&#xA;Catch ex As System.Exception&#xA;    out_ErrorMessage = &quot;BuildFixture failed: &quot; &amp; ex.Message&#xA;End Try&#xA;" DisplayName="Invoke Code - Build Fixture" sap2010:WorkflowViewState.IdRef="InvokeCode_Smoke_1">
      <ui:InvokeCode.Arguments>
        <OutArgument x:TypeArguments="sd:DataTable" x:Key="out_Sheet">[dtSheet]</OutArgument>
        <OutArgument x:TypeArguments="scg:List(x:String)" x:Key="out_ExactColumns">[lsExactColumns]</OutArgument>
        <OutArgument x:TypeArguments="scg:List(x:String)" x:Key="out_FilterColumns">[lsFilterColumns]</OutArgument>
        <OutArgument x:TypeArguments="x:String" x:Key="out_QueryJson">[strQueryJson]</OutArgument>
        <OutArgument x:TypeArguments="x:Boolean" x:Key="out_Success">[boolSuccess]</OutArgument>
        <OutArgument x:TypeArguments="x:String" x:Key="out_ErrorMessage">[strErrorMessage]</OutArgument>
      </ui:InvokeCode.Arguments>
    </ui:InvokeCode>
    <ui:CheckTrue DisplayName="Check True - Build Fixture" ErrorMessage="[strErrorMessage]" Expression="[boolSuccess]" sap2010:WorkflowViewState.IdRef="CheckTrue_Smoke_1" />
