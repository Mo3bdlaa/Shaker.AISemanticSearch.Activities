    <ui:InvokeCode ContinueOnError="{x:Null}" Code="' Regression guard for filter keys. Rank=5 is passed as a FILTER, so smoke-2&#xA;' (Rank=9) must be absent entirely - not merely ranked lower. If filter keys&#xA;' ever revert to scoring, this returns 2 rows and the test fails here.&#xA;out_Success = False&#xA;out_ErrorMessage = &quot;&quot;&#xA;Try&#xA;    If in_Results Is Nothing Then&#xA;        Throw New System.Exception(&quot;retrieval returned no table.&quot;)&#xA;    End If&#xA;    If in_Results.Rows.Count &lt;&gt; 1 Then&#xA;        Throw New System.Exception(&#xA;            &quot;expected exactly 1 row (only smoke-1 has Rank=5) but got &quot; &amp;&#xA;            in_Results.Rows.Count.ToString() &amp;&#xA;            &quot;. Filter columns appear to be scoring instead of excluding.&quot;)&#xA;    End If&#xA;    Dim docId As String = If(in_Results.Rows(0)(&quot;DocId&quot;), &quot;&quot;).ToString()&#xA;    If Not String.Equals(docId, &quot;smoke-1&quot;, StringComparison.OrdinalIgnoreCase) Then&#xA;        Throw New System.Exception(&quot;expected DocId 'smoke-1' but got '&quot; &amp; docId &amp; &quot;'.&quot;)&#xA;    End If&#xA;    out_Success = True&#xA;Catch ex As System.Exception&#xA;    out_ErrorMessage = &quot;AssertRetrieve failed: &quot; &amp; ex.Message&#xA;End Try&#xA;" DisplayName="Invoke Code - Assert Retrieve" sap2010:WorkflowViewState.IdRef="InvokeCode_S3">
