    <ui:LogMessage DisplayName="Log Message - building in-memory fixture..." sap2010:WorkflowViewState.IdRef="LogMessage_S1" Message="[&quot;SmokeTest: building in-memory fixture...&quot;]" />
    <ui:InvokeCode ContinueOnError="{x:Null}" Code="' Builds the smoke-test fixture in memory, so the test needs no Excel file&#xA;' and no values baked into the workflow. Two single-row documents:&#xA;'   smoke-1  Rank=5  Harvard University&#xA;'   smoke-2  Rank=9  Stanford University&#xA;' &quot;Rank&quot; is ingested exact and then used as a FILTER at retrieval, so only&#xA;' smoke-1 may come back. &quot;Name&quot; stays semantic.&#xA;' Also derives the deliberately-wrong model and dimension used to prove the&#xA;' identity guards abort an ingest before anything is written.&#xA;out_Success = False&#xA;out_ErrorMessage = &quot;&quot;&#xA;out_Sheet = New System.Data.DataTable()&#xA;out_ExactColumns = New System.Collections.Generic.List(Of String)()&#xA;out_FilterColumns = New System.Collections.Generic.List(Of String)()&#xA;out_QueryJson = &quot;&quot;&#xA;out_BadUrl = &quot;&quot;&#xA;out_ExactQueryJson = &quot;&quot;&#xA;out_WrongModel = &quot;&quot;&#xA;out_WrongDim = 0&#xA;Try&#xA;    out_Sheet.Columns.Add(&quot;docId&quot;, GetType(String))&#xA;    out_Sheet.Columns.Add(&quot;Rank&quot;, GetType(String))&#xA;    out_Sheet.Columns.Add(&quot;Name&quot;, GetType(String))&#xA;    out_Sheet.Rows.Add(&quot;smoke-1&quot;, &quot;5&quot;, &quot;Harvard University&quot;)&#xA;    out_Sheet.Rows.Add(&quot;smoke-2&quot;, &quot;9&quot;, &quot;Stanford University&quot;)&#xA;&#xA;    out_ExactColumns.Add(&quot;docId&quot;)&#xA;    out_ExactColumns.Add(&quot;Rank&quot;)&#xA;    out_FilterColumns.Add(&quot;Rank&quot;)&#xA;&#xA;    ' Name is deliberately a loose match: semantic scoring should still rank it,&#xA;    ' while Rank as a filter must exclude smoke-2 outright.&#xA;    out_QueryJson = &quot;{&quot;&quot;Rank&quot;&quot;:&quot;&quot;5&quot;&quot;,&quot;&quot;Name&quot;&quot;:&quot;&quot;university&quot;&quot;}&quot;&#xA;&#xA;    ' All-exact/all-filter query plus a deliberately unusable endpoint: if the&#xA;    ' retrieval still succeeds, no embedding request was made. Port 9 is the&#xA;    ' discard port, so a call would fail fast rather than hang.&#xA;    out_ExactQueryJson = &quot;{&quot;&quot;Rank&quot;&quot;:&quot;&quot;5&quot;&quot;}&quot;&#xA;    out_BadUrl = &quot;http://127.0.0.1:9/embeddings-must-not-be-called&quot;&#xA;&#xA;    ' Model names compare with the provider prefix stripped, so a suffix is&#xA;    ' what makes this reliably a different model.&#xA;    out_WrongModel = If(in_Model, &quot;&quot;) &amp; &quot;-smoketest-not-the-real-model&quot;&#xA;    out_WrongDim = in_EmbeddingDim + 8&#xA;&#xA;    out_Success = True&#xA;Catch ex As System.Exception&#xA;    out_ErrorMessage = &quot;BuildFixture failed: &quot; &amp; ex.Message&#xA;End Try&#xA;" DisplayName="Invoke Code - Build Fixture" sap2010:WorkflowViewState.IdRef="InvokeCode_S1">
