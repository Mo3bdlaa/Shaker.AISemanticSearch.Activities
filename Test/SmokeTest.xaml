    <ui:InvokeCode ContinueOnError="{x:Null}" Code="' Skip-unchanged: re-ingesting identical data must cost nothing. The doc-level&#xA;' hash (content + field modes) matches, so FilterUnchanged drops every document&#xA;' before any embedding call and nothing is written or published.&#xA;' This is also the only automated check on that hash being computed&#xA;' consistently in its two places - see docs/architecture.md.&#xA;out_Success = False&#xA;out_ErrorMessage = &quot;&quot;&#xA;Try&#xA;    If in_Errors IsNot Nothing AndAlso in_Errors.Count &gt; 0 Then&#xA;        Throw New System.Exception(&quot;re-ingest reported: &quot; &amp; String.Join(&quot; | &quot;, in_Errors.ToArray()))&#xA;    End If&#xA;    If in_RowsWritten &lt;&gt; 0 Then&#xA;        Throw New System.Exception(&#xA;            &quot;expected 0 rows written when re-ingesting unchanged data but got &quot; &amp;&#xA;            in_RowsWritten.ToString() &amp; &quot; - skip-unchanged is not working.&quot;)&#xA;    End If&#xA;    out_Success = True&#xA;Catch ex As System.Exception&#xA;    out_ErrorMessage = &quot;AssertSkipUnchanged failed: &quot; &amp; ex.Message&#xA;End Try&#xA;" DisplayName="Invoke Code - Assert Skip Unchanged" sap2010:WorkflowViewState.IdRef="InvokeCode_S4">
